# copy to server/.env
# Google Gemini key from https://aistudio.google.com (Get API key)
LLM_API_KEY=your-gemini-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
# optional: enables dense retrieval (hybrid). Any OpenAI-compatible /embeddings endpoint, e.g. Ollama: http://localhost:11434/v1
EMBED_MODEL=
EMBED_BASE_URL=
PORT=8787
