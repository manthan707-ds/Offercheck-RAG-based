# copy to server/.env
# Google Gemini key from https://aistudio.google.com (Get API key)
# Render: set this in the dashboard. Until it is set, the app stays in demo (rules-only) mode.
LLM_API_KEY=your-gemini-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_REASONING=none
# optional: enables dense retrieval (hybrid). Any OpenAI-compatible /embeddings endpoint, e.g. Ollama: http://localhost:11434/v1
EMBED_MODEL=
EMBED_BASE_URL=
PORT=8787
# Vercel (frontend only): set this at build time to your Render URL so scans hit the API.
# VITE_API_URL=https://your-app.onrender.com
