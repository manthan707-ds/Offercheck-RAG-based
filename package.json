{
 "name": "offercheck-rag",
 "private": true,
 "workspaces": [
  "server",
  "client"
 ],
 "scripts": {
  "dev": "concurrently -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
  "eval": "npm run eval -w server",
  "typecheck": "tsc --noEmit -p server && tsc --noEmit -p client",
  "build": "npm run build -w client",
  "start": "npm run start -w server"
 },
 "devDependencies": {
  "concurrently": "^9.0.0",
  "typescript": "^5.6.0"
 },
 "engines": {
  "node": ">=20"
 }
}